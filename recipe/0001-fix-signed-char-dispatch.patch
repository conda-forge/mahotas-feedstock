From 8dbfd97d9241fea7df680a32df404f31ae09cad1 Mon Sep 17 00:00:00 2001
From: Luis Pedro Coelho <luis@luispedro.org>
Date: Wed, 23 Sep 2026 08:59:39 +1000
Subject: [PATCH] BUG Fix signed char dispatch for NPY_BYTE

NPY_BYTE (int8) was dispatched to plain `char`, whose signedness is
implementation-defined: signed on x86/x86_64, but unsigned by default
on aarch64 and other ARM/PowerPC targets. On aarch64 this made int8
values appear as 0..255 instead of -128..127, silently defeating the
negative-value check in features/_texture.cpp's cooccurence() and
causing out-of-bounds writes into the cooccurrence matrix (allocated
from Python based on the correctly-signed max()), which crashed with
a hard abort/segfault instead of raising ValueError.

Use `signed char` instead of `char` for NPY_BYTE in dispatch.hpp and
numpy.hpp, fixing every extension that dispatches on integer types,
not just texture.

See https://github.com/conda-forge/mahotas-feedstock/pull/55

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 mahotas/numpypp/dispatch.hpp | 2 +-
 mahotas/numpypp/numpy.hpp    | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/mahotas/numpypp/dispatch.hpp b/mahotas/numpypp/dispatch.hpp
index ffc7f05..fd92d5a 100644
--- a/mahotas/numpypp/dispatch.hpp
+++ b/mahotas/numpypp/dispatch.hpp
@@ -8,7 +8,7 @@ typedef unsigned short ushort;
     case NPY_BOOL: HANDLE(bool); break; \
     \
     case NPY_UBYTE: HANDLE(unsigned char); break; \
-    case NPY_BYTE: HANDLE(char); break; \
+    case NPY_BYTE: HANDLE(signed char); break; \
     \
     case NPY_SHORT: HANDLE(short); break; \
     case NPY_USHORT: HANDLE(unsigned short); break; \
diff --git a/mahotas/numpypp/numpy.hpp b/mahotas/numpypp/numpy.hpp
index f766585..0409f23 100644
--- a/mahotas/numpypp/numpy.hpp
+++ b/mahotas/numpypp/numpy.hpp
@@ -31,7 +31,7 @@ npy_intp dtype_code();
 
 DECLARE_DTYPE_CODE(bool, NPY_BOOL)
 DECLARE_DTYPE_CODE(float, NPY_FLOAT)
-DECLARE_DTYPE_CODE(char, NPY_BYTE)
+DECLARE_DTYPE_CODE(signed char, NPY_BYTE)
 DECLARE_DTYPE_CODE(unsigned char, NPY_UBYTE)
 DECLARE_DTYPE_CODE(short, NPY_SHORT)
 DECLARE_DTYPE_CODE(unsigned short, NPY_USHORT)
